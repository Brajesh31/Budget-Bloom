# Copy this file to expense/.env for local development.
# Use disposable test services only. Never commit real credentials.
#
# WARNING: current expense/utils/dbConfig.jsx reads NEXT_PUBLIC_DATABASE_URL
# from code imported by client components. Next.js publishes NEXT_PUBLIC_ values
# in the browser bundle. Do not put a privileged or production database URL here.
# Move database access server-side and use DATABASE_URL before handling real data.
NEXT_PUBLIC_DATABASE_URL=postgresql://DEV_ONLY_REPLACE_WITH_DISPOSABLE_DATABASE_URL

# Drizzle CLI reads DATABASE_URL from expense/.env via dotenv/config.
DATABASE_URL=postgresql://DEV_ONLY_REPLACE_WITH_DISPOSABLE_DATABASE_URL

# Use Clerk development/test keys. Keep the secret key private.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_CLERK_PUBLISHABLE_KEY
CLERK_SECRET_KEY=sk_test_REPLACE_WITH_CLERK_SECRET_KEY
